# Local-only secrets; copy to backend/.env. Never commit real credentials.
CALA_MCP_URL=https://api.cala.ai/mcp/
CALA_API_KEY=
# Optional bearer authentication for a custom proxy, not Cala's documented key header.
# CALA_MCP_TOKEN=
CALA_TRANSPORT=streamable_http
# Relative to backend/. Inspect the real server schemas before making this file.
# CALA_TOOL_MAPPING=config/cala-tools.json

# codex uses your existing local Codex CLI login. No model override is imposed.
MODEL_PROVIDER=codex
CODEX_EXECUTABLE=codex
MODEL_TIMEOUT_SECONDS=20
# Conversation generation has a separate deadline and capacity limit.
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_CONCURRENCY=2

# Alternative: any provider supporting OpenAI-compatible chat/completions + JSON schema.
# MODEL_PROVIDER=openai_compatible
# MODEL_BASE_URL=https://your-provider.example/v1
# MODEL_API_KEY=
# MODEL_NAME=your-model
# DeepSeek works too: MODEL_BASE_URL=https://api.deepseek.com, MODEL_NAME=deepseek-chat
# (it lacks structured outputs, so chat falls back to JSON-object mode).
# MODEL_PROVIDER=disabled keeps semantic fields unknown and disables live chat.

FRONTEND_ORIGIN=http://localhost:3000
LOOKBACK_MONTHS=60
PRELIMINARY_LIMIT=10
PROFILE_LIMIT=5
CALA_CONCURRENCY=4
CALA_CALL_LIMIT=20
CALA_REQUEST_TIMEOUT_SECONDS=15
RUN_DEADLINE_SECONDS=90
ASSEMBLY_RESERVE_SECONDS=10
CACHE_TTL_SECONDS=3600
RETENTION_SECONDS=3600
